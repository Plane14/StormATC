<UserControl x:Class="StormATC.Desktop.Views.MissionBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type={x:Type vm:MissionBuilderViewModel}}"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:StormATC.Desktop.ViewModels">

  <Grid Background="{StaticResource SurfaceBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource SurfaceElevatedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="26,16">
      <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
        <TextBlock Text="Mission Builder"
                   FontSize="17"
                   FontWeight="SemiBold" />
        <TextBlock Text="Configure and run continuous flight missions with automatic leg planning."
                   Style="{StaticResource SecondaryTextStyle}"
                   Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="26,18,20,10">
      <StackPanel MaxWidth="1040" HorizontalAlignment="Left">

        <!-- Mission Configuration -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="MISSION CONFIGURATION" Style="{StaticResource SectionHeaderStyle}" />

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="MIN RANGE (NM)" Style="{StaticResource LabelTextStyle}" />
                <TextBox Text="{Binding MinRangeNm, UpdateSourceTrigger=PropertyChanged}"
                         Width="120"
                         HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="MAX RANGE (NM)" Style="{StaticResource LabelTextStyle}" />
                <TextBox Text="{Binding MaxRangeNm, UpdateSourceTrigger=PropertyChanged}"
                         Width="120"
                         HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="SERVICE TIME (MIN)" Style="{StaticResource LabelTextStyle}" />
                <TextBox Text="{Binding ServiceTimeMinutes, UpdateSourceTrigger=PropertyChanged}"
                         Width="120"
                         HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Column="3">
                <TextBlock Text="RESERVE FACTOR" Style="{StaticResource LabelTextStyle}" />
                <TextBox Text="{Binding ReserveFactor, UpdateSourceTrigger=PropertyChanged}"
                         Width="120"
                         HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Mission Control -->
        <Border Background="{StaticResource AccentSubtleBrush}"
                BorderBrush="{StaticResource AccentDimBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
          <StackPanel>
            <TextBlock Text="MISSION CONTROL"
                       Style="{StaticResource SectionHeaderStyle}"
                       Foreground="{StaticResource AccentBrush}" />
            <WrapPanel Margin="0,8,0,0">
              <Button Content="Start Mission"
                      Command="{Binding StartMissionAsyncCommand}"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Margin="0,0,12,0" />
              <Button Content="Stop Mission"
                      Command="{Binding StopMissionCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,12,0,0" />
          </StackPanel>
        </Border>

        <!-- Mission Log -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="MISSION LOG" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="No missions logged yet."
                       Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
