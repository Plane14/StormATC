<UserControl x:Class="StormATC.Desktop.Views.FlightMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type={x:Type vm:FlightMonitorViewModel}}"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:StormATC.Desktop.ViewModels">

  <Grid Background="{StaticResource SurfaceBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource SurfaceElevatedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="26,16">
      <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
        <TextBlock Text="Flight Monitor"
                   FontSize="17"
                   FontWeight="SemiBold" />
        <TextBlock Text="Real-time flight phase, autopilot status, terrain awareness, and aircraft state."
                   Style="{StaticResource SecondaryTextStyle}"
                   Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="26,18,20,10">
      <StackPanel MaxWidth="1040" HorizontalAlignment="Left">

        <!-- Flight Phase Panel -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="FLIGHT PHASE" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="{Binding CurrentPhase}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0,8,0,0" />
            <TextBlock Text="Current autopilot-managed flight phase. Transitions are driven by the deterministic phase engine."
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <!-- Autopilot Status Panel -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="AUTOPILOT STATUS" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="MODE" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding AutopilotMode}"
                           FontSize="16"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="TARGET ALTITUDE" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding TargetAltitudeFeet, StringFormat={}{0:F0} ft}"
                           FontSize="16"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="TARGET HEADING" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding TargetHeadingDegrees, StringFormat={}{0:F0}°}"
                           FontSize="16"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="3">
                <TextBlock Text="TARGET SPEED" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding TargetSpeedKnots, StringFormat={}{0:F1} kt}"
                           FontSize="16"
                           FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Terrain Awareness Panel -->
        <Border Background="{StaticResource StatusWarnSubtleBrush}"
                BorderBrush="{StaticResource StatusWarnBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="TERRAIN AWARENESS"
                       Style="{StaticResource SectionHeaderStyle}"
                       Foreground="{StaticResource StatusWarnBrush}" />
            <TextBlock Text="Terrain profiling and minimum safe altitude monitoring. Requires SimConnect terrain data."
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,4,0,0" />
            <Border Background="{StaticResource SurfaceBackgroundBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="Required Altitude Ahead"
                           Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="-- ft"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="Minimum Safe Altitude"
                           Style="{StaticResource LabelTextStyle}"
                           Margin="0,8,0,0" />
                <TextBlock Text="-- ft"
                           FontSize="16"
                           FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Aircraft State Panel -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="AIRCRAFT STATE" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,8,0,0" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
